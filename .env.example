# TaskSync — server environment
# Copy to .env (server reads it via dotenv; root .env works for all workspaces).

# Convex deployment URL (from `npx convex dev` or the Convex dashboard)
CONVEX_URL=
# Deployment name (lets `npx convex run/deploy` find the project from the repo root)
CONVEX_DEPLOYMENT=

# Port for the API server (default 8787; the web dev server proxies /api here)
PORT=8787

# ---------------------------------------------------------------------------
# apps/web environment (put these in apps/web/.env.local for dev and
# apps/web/.env.production for production builds — Vite only exposes VITE_*)
# ---------------------------------------------------------------------------

# Google OAuth (Sign in with Google) — OAuth 2.0 Client ID (type "Web application")
# From Google Cloud Console → APIs & Services → Credentials. The authorized
# JavaScript origins must include http://localhost:5173 and https://teamdailysync.web.app
VITE_GOOGLE_CLIENT_ID=

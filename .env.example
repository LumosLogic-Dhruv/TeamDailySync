# TaskSync — server environment
# Copy to .env (server reads it via dotenv; root .env works for all workspaces).

# Convex deployment URL (from `npx convex dev` or the Convex dashboard)
CONVEX_URL=
# Deployment name (lets `npx convex run/deploy` find the project from the repo root)
CONVEX_DEPLOYMENT=

# Port for the API server (default 8787; the web dev server proxies /api here)
PORT=8787

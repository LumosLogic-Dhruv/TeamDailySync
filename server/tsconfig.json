{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@tasksync/shared": ["../shared/index.ts"],
      "@tasksync/shared/types": ["../shared/types/index.ts"],
      "@tasksync/shared/constants": ["../shared/constants/index.ts"],
      "@tasksync/shared/utils": ["../shared/utils/index.ts"],
      "@tasksync/shared/utils/*": ["../shared/utils/*.ts"]
    }
  },
  "include": ["src", "../shared"]
}
